<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.com.empresa.view.MainController">

    <!-- BARRA LATERAL (MENU) -->
    <left>
        <VBox prefWidth="200.0" spacing="15.0" style="-fx-background-color: #2c3e50;">
            <children>
                <Label text="SISTEMA VENDAS" textFill="WHITE">
                    <Font name="System Bold" size="18.0" />
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </Label>

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirCadastroCliente" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand;" text="👥 Clientes">
                    <padding>
                        <Insets bottom="10.0" top="10.0" />
                    </padding>
                </Button>

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirCadastroProduto" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand;" text="📦 Produtos">
                    <padding>
                        <Insets bottom="10.0" top="10.0" />
                    </padding>
                </Button>

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirCadastroVendedor" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand;" text="👨‍💼 Vendedores">
                    <padding>
                        <Insets bottom="10.0" top="10.0" />
                    </padding>
                </Button>

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirTelaVenda" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="🛒 PDV - Vendas">
                    <padding>
                        <Insets bottom="10.0" top="10.0" />
                    </padding>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                        onAction="#abrirHistoricoVendas"
                        style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-cursor: hand;"
                        text="📜 Histórico de Vendas">
                    <padding>
                        <Insets bottom="10.0" top="10.0" />
                    </padding>
                    <VBox.margin>
                        <Insets top="5.0" />
                    </VBox.margin>
                </Button>

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                        onAction="#abrirRelatorios"
                        style="-fx-background-color: #d35400; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;"
                        text="📊 Relatórios de Vendas">
                    <padding>
                        <Insets bottom="10.0" top="10.0" />
                    </padding>
                    <VBox.margin>
                        <Insets top="5.0" />
                    </VBox.margin>
                </Button>

                <VBox VBox.vgrow="ALWAYS" /> <!-- Espaçador para empurrar o sair para baixo -->

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="Sair">
                    <padding>
                        <Insets bottom="10.0" top="10.0" />
                    </padding>
                </Button>
            </children>
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
            </padding>
        </VBox>
    </left>

    <!-- ÁREA CENTRAL DINÂMICA -->
    <center>
        <StackPane fx:id="conteudoPrincipal" prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <children>
                <Label text="Bem-vindo ao Sistema de Vendas&#10;Selecione uma opção no menu lateral" textAlignment="CENTER" textFill="#7c7c7c">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
            </children>
        </StackPane>
    </center>

</BorderPane>