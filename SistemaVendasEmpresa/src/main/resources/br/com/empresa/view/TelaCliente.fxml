<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- PASSO 5 APLICADO: Dimensões fixas removidas, adicionado maxWidth e maxHeight -->
<VBox spacing="15" alignment="CENTER" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.empresa.view.ClienteController" maxWidth="Infinity" maxHeight="Infinity">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Cadastro de Clientes Profissional" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <!-- Linha 0 -->
        <Label text="Nome/Razão Social:"/>
        <TextField fx:id="txtNome" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="300"/>

        <Label text="CPF/CNPJ:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <TextField fx:id="txtCpfCnpj" onKeyReleased="#aoDigitarCpfCnpj" GridPane.columnIndex="3" GridPane.rowIndex="0" promptText="Somente números"/>

        <!-- Linha 1 -->
        <Label text="Email:" GridPane.rowIndex="1"/>
        <TextField fx:id="txtEmail" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Telefone:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <TextField fx:id="txtTelefone" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

        <!-- Linha 2 -->
        <Label text="CEP:" GridPane.rowIndex="2"/>
        <TextField fx:id="txtCep" GridPane.columnIndex="1" GridPane.rowIndex="2" promptText="00000-000"/>

        <Label text="Endereço:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
        <TextField fx:id="txtEndereco" GridPane.columnIndex="3" GridPane.rowIndex="2"/>

        <!-- Linha 3 (Campos Novos) -->
        <Label text="Bairro:" GridPane.rowIndex="3"/>
        <TextField fx:id="txtBairro" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Cidade:" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
        <TextField fx:id="txtCidade" GridPane.columnIndex="3" GridPane.rowIndex="3"/>

        <!-- Linha 4 (Campos Novos) -->
        <Label text="Estado:" GridPane.rowIndex="4"/>
        <TextField fx:id="txtEstado" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <Label text="UF:" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
        <TextField fx:id="txtUf" prefWidth="50" GridPane.columnIndex="3" GridPane.rowIndex="4"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Salvar Cliente" onAction="#handleSalvar" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button text="Excluir" onAction="#handleDeletar" style="-fx-background-color: #c0392b; -fx-text-fill: white;"/>
        <Button text="Limpar Campos" onAction="#limparCampos"/>
    </HBox>

    <Label fx:id="lblStatus" style="-fx-text-fill: blue; -fx-font-weight: bold;"/>

    <!-- VBox.vgrow="ALWAYS" faz com que a tabela preencha todo o espaço restante para baixo -->
    <TableView fx:id="tabelaClientes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNome" text="Nome" prefWidth="200"/>
            <TableColumn fx:id="colCpf" text="CPF/CNPJ" prefWidth="130"/>
            <TableColumn fx:id="colTelefone" text="Telefone" prefWidth="110"/>
            <TableColumn fx:id="colCidade" text="Cidade" prefWidth="120"/>
            <TableColumn fx:id="colUf" text="UF" prefWidth="40"/>
        </columns>
        <!-- Força a tabela a não ficar achatada se o usuário diminuir muito a janela -->
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>