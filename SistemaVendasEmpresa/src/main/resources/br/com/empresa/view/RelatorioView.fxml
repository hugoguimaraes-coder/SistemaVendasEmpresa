<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.empresa.view.RelatorioController"
      style="-fx-background-color: #f4f7f6;">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label text="📊 Relatório Gerencial">
            <font>
                <Font name="System Bold" size="26.0" />
            </font>
        </Label>

        <Pane HBox.hgrow="ALWAYS" />

        <Button onAction="#carregarDados" text="🔄 Filtrar e Atualizar"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-background-radius: 5;">
            <padding>
                <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
            </padding>
        </Button>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
        <Label text="📅 Período:" style="-fx-font-weight: bold;" />
        <DatePicker fx:id="dpInicio" prefWidth="150.0" promptText="Início" />
        <DatePicker fx:id="dpFim" prefWidth="150.0" promptText="Fim" />
    </HBox>

    <HBox spacing="20.0">
        <VBox prefWidth="350.0" style="-fx-background-color: #27ae60; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <Label text="FATURAMENTO TOTAL DA LOJA" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>
            <Label fx:id="lblTotalLoja" text="R$ 0,00" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="36.0" />
                </font>
            </Label>
        </VBox>
    </HBox>

    <Label text="Desempenho por Vendedor">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
        <VBox.margin>
            <Insets top="10.0" />
        </VBox.margin>
    </Label>

    <TableView fx:id="tabelaRelatorio" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10;">
        <columns>
            <TableColumn fx:id="colVendedor" prefWidth="250.0" text="Vendedor" />
            <TableColumn fx:id="colQtdVendas" prefWidth="120.0" text="Qtd. de Vendas" />
            <TableColumn fx:id="colTotalVendido" prefWidth="180.0" text="Total Acumulado (R$)" />
            <TableColumn fx:id="colComissao" prefWidth="180.0" text="Comissão (R$)" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>