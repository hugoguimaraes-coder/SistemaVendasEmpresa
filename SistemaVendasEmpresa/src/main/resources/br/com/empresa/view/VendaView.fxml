<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<HBox spacing="20" alignment="CENTER" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.empresa.view.VendaController" maxWidth="Infinity" maxHeight="Infinity" style="-fx-background-color: #ecf0f1;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- LADO ESQUERDO: DADOS E CARRINHO (70% da tela) -->
    <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
        <Label text="Ponto de Venda (PDV)" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <GridPane hgap="15" vgap="15">
            <!-- Linha 1: Vendedor e Cliente -->
            <Label text="Vendedor:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="cbVendedor" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="Selecione..."/>

            <Label text="Cliente:" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
            <VBox spacing="5" GridPane.columnIndex="3" GridPane.rowIndex="0">
                <TextField fx:id="txtBuscaCliente" promptText="🔍 Digite Nome ou CPF/CNPJ..." onKeyReleased="#filtrarClientes"/>
                <ComboBox fx:id="cbCliente" prefWidth="250" promptText="Selecione o Cliente"/>
            </VBox>

            <Separator GridPane.columnSpan="4" GridPane.rowIndex="1"/>

            <!-- Linha 2: Produto e Quantidade -->
            <Label text="Produto:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>

            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <TextField fx:id="txtBuscaProduto" promptText="🔍 Nome ou Cód. Barras..." onKeyReleased="#filtrarProdutos"/>
                <ComboBox fx:id="cbProduto" prefWidth="250" promptText="Selecionar Produto"/>
            </VBox>

            <Label text="Qtd:" GridPane.columnIndex="2" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
            <HBox spacing="10" GridPane.columnIndex="3" GridPane.rowIndex="2">
                <TextField fx:id="txtQuantidade" prefWidth="60" text="1" alignment="CENTER"/>
                <Button text="➕ Adicionar" onAction="#adicionarAoCarrinho" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>
        </GridPane>

        <!-- Tabela do Carrinho de Compras -->
        <TableView fx:id="tabelaItens" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colProduto" text="Produto" prefWidth="250"/>
                <TableColumn fx:id="colQtd" text="Qtd" prefWidth="80"/>
                <TableColumn fx:id="colPreco" text="Preço Unit (R$)" prefWidth="120"/>
                <TableColumn fx:id="colSubtotal" text="Subtotal (R$)" prefWidth="120"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <!-- LADO DIREITO: RESUMO E CHECKOUT (30% da tela) -->
    <VBox spacing="20" prefWidth="350" style="-fx-background-color: #2c3e50; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 0);">
        <Label text="Resumo da Compra" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>

        <!-- Painel Branco de Valores -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5;">
            <HBox>
                <Label text="Subtotal:" style="-fx-font-size: 16px;"/>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblSubtotal" text="R$ 0,00" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Desconto:" style="-fx-font-size: 16px;"/>
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="txtDesconto" prefWidth="80" promptText="0.00" alignment="CENTER_RIGHT" onKeyReleased="#calcularTotalFinal"/>
            </HBox>

            <Separator />

            <HBox>
                <Label text="TOTAL:" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblTotal" text="R$ 0,00" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
            </HBox>
        </VBox>

        <Label text="Pagamento" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

        <ComboBox fx:id="cbFormaPagamento" maxWidth="Infinity" promptText="Selecione a Forma" style="-fx-font-size: 14px;"/>

        <!-- Esta HBox começa invisível e só aparece se for Crédito/Cheque -->
        <HBox fx:id="boxParcelas" spacing="10" alignment="CENTER_LEFT" visible="false" managed="false">
            <Label text="Parcelas:" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"/>
            <ComboBox fx:id="cbParcelas" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        </HBox>

        <Region VBox.vgrow="ALWAYS" />

        <Button text="FINALIZAR VENDA" onAction="#finalizarVenda" maxWidth="Infinity" prefHeight="60" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;"/>

        <Label fx:id="lblStatus" text="" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>
    </VBox>

</HBox>